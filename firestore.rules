rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Enquiries — anyone can create (website leads), only auth can read/delete
    match /enquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ── Packages, Destinations, Blogs, Testimonials, Offers, Media
    // Public can read, only authenticated admin can write
    match /packages/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /destinations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blogs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /testimonials/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /offers/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /media/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Settings (company info, page settings) — public read, auth write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
