rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Package images — public read, only authenticated admin can upload/delete
    match /packages/{fileName} {
      allow read:   if true;
      allow write:  if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024   // max 10MB
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Media library images — public read, only authenticated admin can upload/delete
    match /media/{fileName} {
      allow read:   if true;
      allow write:  if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Destination images
    match /destinations/{fileName} {
      allow read:   if true;
      allow write:  if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── General images fallback
    match /images/{fileName} {
      allow read:   if true;
      allow write:  if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
